{
  "name": "Tauri Android Dev",
  "build": {
    "dockerfile": "../Containerfile",
    "context": ".."
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tauri-apps.tauri-vscode"
      ]
    }
  },
  "mounts": [
    "source=${localEnv:HOME}/.cargo,target=/root/.cargo,type=bind",
    "source=${localEnv:HOME}/.gradle,target=/root/.gradle,type=bind"
  ],
  "runArgs": [
    "--network=host",
    "--privileged"
  ],
  "remoteUser": "root"
}
